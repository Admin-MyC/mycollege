rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Site promotional content (Mission, Vision, Objectives, About, etc.)
    match /site_content/{documentId} {
      allow read: if true;
      allow write: if true; // Allow content updates from admin panel in promo site
    }

    // Platform updates and announcements
    match /updates/{updateId} {
      allow read: if true;
      allow write: if true;
    }

    // Platform products and modules
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Visual theme and layout settings
    match /page_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Lead / Demo requests from prospective private schools
    match /demo_requests/{requestId} {
      allow read: if true;
      allow create: if request.resource.data.email is string 
                   && request.resource.data.schoolName is string
                   && request.resource.data.contactName is string;
      allow update, delete: if true;
    }
  }
}
